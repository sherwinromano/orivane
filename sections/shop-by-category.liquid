{{ 'shop-by-category.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign loading = 'lazy'
  if section.index == 1
    assign loading = 'eager'
  endif

  assign card_heading_tag = 'h3'
  if section.settings.heading == blank
    assign card_heading_tag = 'h2'
  endif

  case section.settings.image_ratio
    when 'portrait'
      assign image_ratio = '3 / 4'
    when 'square'
      assign image_ratio = '1 / 1'
    else
      assign image_ratio = '3 / 2'
  endcase
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .category-banner-{{ section.id }} {
    --category-banner-gap: {{ section.settings.card_gap }}px;
    --category-banner-ratio: {{ image_ratio }};
    --category-banner-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }

  @media screen and (min-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width scroll-trigger animate--slide-in section-{{ section.id }}-padding">
    <div class="category-banner category-banner-{{ section.id }}">
      {%- if section.settings.heading != blank -%}
        <h2
          class="category-banner__title {{ section.settings.heading_size }} category-banner__title--{{ section.settings.heading_alignment }}"
          style="{% if section.settings.heading_uppercase %}text-transform: uppercase;{% endif %}"
        >
          {{- section.settings.heading | escape -}}
        </h2>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="category-banner__list" role="list">
          {%- for block in section.blocks -%}
            <li class="category-banner__item" {{ block.shopify_attributes }}>
              <div class="category-banner__card">
                <div class="category-banner__media">
                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 1600
                      | image_tag:
                        class: 'category-banner__image',
                        widths: '375, 550, 750, 1100, 1500',
                        sizes: '(min-width: 1200px) 560px, (min-width: 768px) 50vw, 100vw',
                        loading: loading,
                        alt: '',
                        style: 'object-position: '
                      | append: block.settings.image.presentation.focal_point
                    }}
                  {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg category-banner__image' }}
                  {%- endif -%}
                </div>

                <div class="category-banner__content">
                  {%- if block.settings.heading != blank -%}
                    <{{ card_heading_tag }} class="category-banner__heading">
                      {{- block.settings.heading | escape -}}
                    </{{ card_heading_tag }}>
                  {%- endif -%}

                  {%- if block.settings.link != blank and block.settings.button_label != blank -%}
                    <a class="category-banner__button" href="{{ block.settings.link }}">
                      <span>{{ block.settings.button_label | escape }}</span>
                      {%- if block.settings.heading != blank -%}
                        <span class="visually-hidden">{{ block.settings.heading | escape }}</span>
                      {%- endif -%}
                    </a>
                  {%- endif -%}
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shop by category",
  "tag": "section",
  "class": "section-category-banner",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Section title"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to hide the title.",
      "default": "Shop by category"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h3", "label": "Small" },
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" },
        { "value": "h0", "label": "Extra large" }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Uppercase heading",
      "default": false
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "landscape", "label": "Landscape (3:2)" },
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "square", "label": "Square (1:1)" }
      ],
      "default": "landscape"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap between cards",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Text overlay strength",
      "info": "Darkens each image so the text stays readable.",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Category card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Women"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link",
          "info": "Select a collection or page. The button is hidden without a link."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by category",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "heading": "Women"
          }
        },
        {
          "type": "card",
          "settings": {
            "heading": "Men"
          }
        }
      ]
    }
  ]
}
{% endschema %}
