{{ 'customer-reviews.css' | asset_url | stylesheet_tag }}
<script src="{{ 'customer-reviews.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width scroll-trigger animate--slide-in section-{{ section.id }}-padding">
    <div class="customer-reviews">
      {%- if section.settings.heading != blank -%}
        <h2
          class="
            customer-reviews__title {{ section.settings.heading_size }}
            {%- if section.settings.uppercase_heading %} customer-reviews__title--uppercase{% endif -%}
          "
          style="text-align: {{ section.settings.heading_alignment }};"
        >
          {{- section.settings.heading | escape -}}
        </h2>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <customer-reviews class="customer-reviews__slider" data-dot-label="Go to review group">
          <ul
            class="customer-reviews__track"
            role="list"
            tabindex="0"
            aria-label="Customer reviews"
            data-track
          >
            {%- for block in section.blocks -%}
              <li class="customer-reviews__item" {{ block.shopify_attributes }}>
                <figure class="customer-reviews__review">
                  {%- if block.settings.quote != blank -%}
                    <blockquote class="customer-reviews__quote">
                      <p>&ldquo;{{ block.settings.quote | escape }}&rdquo;</p>
                    </blockquote>
                  {%- endif -%}

                  <figcaption class="customer-reviews__caption">
                    {%- if block.settings.name != blank -%}
                      <span class="customer-reviews__name">{{ block.settings.name | escape }}</span>
                    {%- endif -%}

                    {%- if block.settings.rating > 0 -%}
                      <span
                        class="customer-reviews__rating"
                        role="img"
                        aria-label="Rated {{ block.settings.rating }} out of 5"
                      >
                        {%- for i in (1..5) -%}
                          <svg
                            class="customer-reviews__star{% if i > block.settings.rating %} customer-reviews__star--empty{% endif %}"
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 20 20"
                            width="14"
                            height="14"
                            aria-hidden="true"
                            focusable="false"
                          >
                            <path fill="currentColor" d="M10 1.5l2.6 5.5 6 .8-4.4 4.2 1.1 6L10 15.1 4.7 18l1.1-6L1.4 7.8l6-.8z" />
                          </svg>
                        {%- endfor -%}
                      </span>
                    {%- endif -%}
                  </figcaption>
                </figure>
              </li>
            {%- endfor -%}
          </ul>

          <div class="customer-reviews__dots" role="group" aria-label="Review pagination" data-dots hidden></div>
        </customer-reviews>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer reviews",
  "tag": "section",
  "class": "section-customer-reviews",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Section title"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to hide the title.",
      "default": "Customer's reviews"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h3", "label": "Small" },
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" },
        { "value": "h0", "label": "Extra large" }
      ],
      "default": "h0"
    },
    {
      "type": "checkbox",
      "id": "uppercase_heading",
      "label": "Uppercase heading",
      "default": true
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review text",
          "default": "Lorem ipsum dolor sit amet consectetur adipiscing elit. Voluptate alias repellat dolor sit possimus consequatur vel."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer name",
          "default": "Karina Bias"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Star rating",
          "info": "Set to 0 to hide the stars.",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "name": "Karina Bias"
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "John Doe"
          }
        },
        {
          "type": "review",
          "settings": {
            "name": "William Jack"
          }
        }
      ]
    }
  ]
}
{% endschema %}
