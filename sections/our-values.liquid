          "type": "value",
          "settings": {
            "icon": "star",
            "heading": "Premium quality",
            "text": "Thoughtfully crafted. Made to last."
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "heart",
            "heading": "A better tomorrow",
            "text": "More sustainable choices for a brighter future."
          }
        }
      ]
    }
  ]
}
{% endschema %}
