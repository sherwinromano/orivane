{{ 'page-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  case template.name
    when 'page'
      assign current_title = page.title
    when 'collection'
      assign current_title = collection.title
    when 'product'
      assign current_title = product.title
    when 'blog'
      assign current_title = blog.title
    when 'article'
      assign current_title = article.title
    else
      assign current_title = page_title
  endcase

  assign heading = section.settings.heading
  if heading == blank
    assign heading = current_title
  endif
-%}

{%- style -%}
  .page-banner-{{ section.id }} {
    --page-banner-bg: {{ section.settings.background_color }};
    --page-banner-overlay: {{ section.settings.overlay_color }};
    --page-banner-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --page-banner-min-height-mobile: {{ section.settings.mobile_height }}px;
    --page-banner-min-height-desktop: {{ section.settings.desktop_height }}px;
    --page-banner-heading-size: {{ section.settings.heading_size }}px;
  }
{%- endstyle -%}

<section class="scroll-trigger animate--slide-in page-banner page-banner-{{ section.id }}">
  <div class="page-banner__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          class: 'page-banner__image',
          widths: '750, 1100, 1500, 1920, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: '',
          style: 'object-position: '
        | append: section.settings.image.presentation.focal_point
      }}
    {%- endif -%}
    <div class="page-banner__overlay"></div>
  </div>

  <div class="page-banner__content">
    <h1 class="page-banner__heading{% if section.settings.uppercase_heading %} page-banner__heading--uppercase{% endif %}">
      {{- heading | escape -}}
    </h1>

    {%- if section.settings.show_breadcrumbs -%}
      <nav class="page-banner__breadcrumb" aria-label="Breadcrumb">
        <ol class="page-banner__breadcrumb-list">
          <li class="page-banner__breadcrumb-item">
            <a class="page-banner__breadcrumb-link" href="{{ routes.root_url }}">
              {{- 'Home' | escape -}}
            </a>
          </li>

          {%- if section.settings.parent_label != blank -%}
            <li class="page-banner__breadcrumb-item">
              {%- if section.settings.parent_url != blank -%}
                <a class="page-banner__breadcrumb-link" href="{{ section.settings.parent_url }}">
                  {{- section.settings.parent_label | escape -}}
                </a>
              {%- else -%}
                <span>{{ section.settings.parent_label | escape }}</span>
              {%- endif -%}
            </li>
          {%- endif -%}

          <li class="page-banner__breadcrumb-item" aria-current="page">
            <span>{{ current_title | escape }}</span>
          </li>
        </ol>
      </nav>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Page banner",
  "tag": "section",
  "class": "section-page-banner",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fallback background color",
      "info": "Shown when no image is selected.",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the title of the current page, collection, product, or blog."
    },
    {
      "type": "checkbox",
      "id": "uppercase_heading",
      "label": "Uppercase heading",
      "default": true
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (desktop)",
      "min": 60,
      "max": 220,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "header",
      "content": "Breadcrumb"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumb",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Banner height (desktop)",
      "min": 300,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 550
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Banner height (mobile)",
      "min": 200,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 360
    }
  ],
  "presets": [
    {
      "name": "Page banner"
    }
  ]
}
{% endschema %}
